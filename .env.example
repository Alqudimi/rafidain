# ============================================================================
# Rafidain — environment configuration
# Copy to .env and adjust. All keys use the RAFIDAIN_ prefix;
# nested settings use "__" (e.g. RAFIDAIN__ENGINE__IMPL=mock).
# ============================================================================

# --- Application -------------------------------------------------------------
RAFIDAIN__HOST=0.0.0.0
RAFIDAIN__PORT=8000
RAFIDAIN__LOG_LEVEL=INFO
# JSON structured logs (recommended for production)
RAFIDAIN__LOG_JSON=true
# Comma-separated API keys — as a JSON array (pydantic-settings parses lists as JSON).
# Empty [] disables auth (development ONLY!).
RAFIDAIN__API_KEYS=[]
# CORS origins — JSON array ("*" allows all).
RAFIDAIN__CORS_ORIGINS=["*"]

# --- Engine (Seed-VC) ---------------------------------------------------------
# "seedvc" (production) | "mock" (CPU-only passthrough engine for dev/tests)
RAFIDAIN__ENGINE__IMPL=seedvc
# auto | cuda | cpu | mps
RAFIDAIN__ENGINE__DEVICE=auto
RAFIDAIN__ENGINE__FP16=true
# Root of the cloned https://github.com/Plachtaa/seed-vc repository
SEED_VC_ROOT=./third_party/seed-vc
# HuggingFace checkpoints (seed-uvit-tat-xlsr-tiny)
RAFIDAIN__ENGINE__HF_REPO=Plachta/Seed-VC
RAFIDAIN__ENGINE__CHECKPOINT=DiT_uvit_tat_xlsr_ema.pth
RAFIDAIN__ENGINE__CONFIG=config_dit_mel_seed_uvit_xlsr_tiny.yml
# Local fine-tuned checkpoint overrides the HF download (Iraqi-dialect model):
# RAFIDAIN__ENGINE__LOCAL_CHECKPOINT=./checkpoints/iraqi_ft/ft_model.pth
# RAFIDAIN__ENGINE__LOCAL_CONFIG=./checkpoints/iraqi_ft/config.yml
RAFIDAIN__ENGINE__CACHE_DIR=./checkpoints
# Eagerly load + warm up the model at startup (recommended in production)
RAFIDAIN__ENGINE__EAGER_LOAD=true
RAFIDAIN__ENGINE__WARMUP=true

# --- Streaming sessions -------------------------------------------------------
# ultra_low | balanced | quality   (see ARCHITECTURE.md for the trade-offs)
RAFIDAIN__DEFAULT_PROFILE=balanced
# Session lifetime without an active WebSocket connection (seconds)
RAFIDAIN__SESSION_TTL_S=300
RAFIDAIN__SESSION_CLEANUP_INTERVAL_S=30
RAFIDAIN__MAX_SESSIONS=64
# Bounded output queue per session (audio blocks) — backpressure guard
RAFIDAIN__SEND_QUEUE_SIZE=64
# Voice-activity gate before the engine: off | webrtc
RAFIDAIN__VAD=off

# --- Web UI ---------------------------------------------------------------------
# Arabic RTL control panel (Gradio) at /web — needs the `webui` extra
# (uv sync --extra webui). The realtime page /live needs nothing extra.
RAFIDAIN__WEBUI=true

# --- Storage & cache ----------------------------------------------------------
RAFIDAIN__DATA_DIR=./data
# Redis URL enables the distributed cache + finetune job queue.
# Empty => in-process implementations (single-node deployment).
RAFIDAIN__REDIS_URL=
